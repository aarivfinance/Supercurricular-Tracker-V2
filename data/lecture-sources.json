{
  "_note": "Lecture hosts read by scripts/scan-lectures.mjs. type: page (rendered listing page) | oxtalks (talks.ox.ac.uk API). link: optional regex for event-page paths; if it matches nothing, the scanner falls back to any link whose card shows an upcoming date. filter: 'subject' keeps only events that match philosophy/politics/economics/law; 'loose' keeps everything except obvious non-lectures. s: default subject.",
  "sources": [
    {
      "name": "LSE public events",
      "type": "page",
      "url": "https://www.lse.ac.uk/events",
      "link": "/events/\\d{4}/\\d{2}/\\d{8,12}",
      "city": "London",
      "filter": "loose",
      "s": "pol",
      "free": true
    },
    {
      "name": "LSE public events",
      "type": "page",
      "url": "https://www.lse.ac.uk/events/search-events",
      "link": "/events/\\d{4}/\\d{2}/\\d{8,12}",
      "city": "London",
      "filter": "subject",
      "s": "pol",
      "free": true
    },
    {
      "name": "Gresham College",
